{
  "root": true,
  "ignorePatterns": [
    "projects/**/*",
    "dist/**/*",
    "coverage/**/*",
    "node_modules/**/*",
    "*.js",
    "*.cjs",
    "*.mjs"
  ],
  "overrides": [
    {
      "files": [
        "*.ts"
      ],
      "parserOptions": {
        "project": [
          "tsconfig.json"
        ],
        "createDefaultProgram": true
      },
      "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:@angular-eslint/recommended"
      ],
      "rules": {
        "@typescript-eslint/no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_"
          }
        ],
        "@typescript-eslint/no-explicit-any": "warn"
      }
    }
  ]
}